optimiser_p_idw <- function(donnees, var_x, var_y, var_output, code_epsg) {
# 1. Conversion spatiale avec les variables dynamiques
donnees_sf <- st_as_sf(donnees, coords = c(var_x, var_y), crs = code_epsg)
# 2. Création dynamique de la formule (ex: "niveau_eau ~ 1")
formule <- as.formula(paste(var_output, "~ 1"))
# 3. Initialisation des paramètres
p_values <- seq(0.5, 10.0, by = 0.25)
mse_results <- numeric(length(p_values))
# 4. Boucle externe : Test des différentes puissances
for (i in seq_along(p_values)) {
current_p <- p_values[i]
squared_errors <- numeric(nrow(donnees_sf))
# 5. Boucle interne : Validation croisée (LOOCV)
for (j in 1:nrow(donnees_sf)) {
train_data <- donnees_sf[-j, ]
test_data  <- donnees_sf[j, ]
idw_fit <- idw(
formula = formule,
locations = train_data,
newdata = test_data,
idp = current_p,
debug.level = 0
)
# 6. Extraction des valeurs et calcul de l'erreur
predicted_val <- idw_fit$var1.pred
# Utilisation des doubles crochets [[ ]] pour extraire
# la valeur de la colonne de test via son nom en texte
actual_val <- test_data[[var_output]]
squared_errors[j] <- (predicted_val - actual_val)^2
}
mse_results[i] <- mean(squared_errors)
}
# 7. Identification de l'optimum
results_df <- data.frame(Power = p_values, MSE = mse_results)
optimal_p <- results_df$Power[which.min(results_df$MSE)]
cat("\nLe paramètre p optimal pour", var_output, "est :", optimal_p, "\n")
# 8. Affichage du graphique de diagnostic
plot(results_df$Power, results_df$MSE, type = "b", pch = 19, col = "blue",
xlab = "Paramètre de puissance (p)",
ylab = "Erreur quadratique moyenne (MSE)",
main = paste("Optimisation IDW :", var_output))
abline(v = optimal_p, col = "red", lty = 2, lwd = 2)
}
#Now, we want to fond the optimal parameter p for the inverse distance weighted estimator
#| label: optimisation-idw
#| echo: true
resultats_opti <- optimiser_p_idw(donnees = data_1974,
var_x = "XUTM",
var_y = "YUTM",
var_output = "totanno",
code_epsg = 32633)
#Now, we want to fond the optimal parameter p for the inverse distance weighted estimator
#| label: optimisation-idw
#| echo: true
resultats_opti <- optimiser_p_idw(donnees = data_1974,
var_x = "XUTM",
var_y = "YUTM",
var_output = "totanno",
code_epsg = 32633)
