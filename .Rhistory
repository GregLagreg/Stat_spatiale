library(knitr)
# Data frame to store posterior summaries
posterior_summaries <- data.frame()
# Set up plotting area for one row and three columns (one plot per year)
par(mfrow = c(1, 3))
for (yr in years) {
post <- bayes_results[[yr]]$posterior
# Robust extraction of posterior samples (handles different geoR versions)
if ("sample" %in% names(post)) {
phi_samples <- post$sample$phi
tau_samples <- post$sample$tausq.rel
} else {
phi_samples <- post$phi$sample
tau_samples <- post$tausq.rel$sample
}
# Calculate the posterior expected value (mean) from the samples
phi_mean <- mean(phi_samples)
tau_mean <- mean(tau_samples)
# Store the results in the summary table
posterior_summaries <- rbind(posterior_summaries, data.frame(
Year = yr,
Phi_Mean_km = phi_mean,
Tau_Rel_Mean = tau_mean
))
# Plot the posterior distribution as a histogram
hist(phi_samples, breaks = 15, col = "steelblue", border = "white",
main = paste("Posterior of Phi -", yr),
xlab = "Range (phi) in km", ylab = "Frequency", freq = FALSE)
}
# Reset plotting area
par(mfrow = c(1, 1))
# Display the summary table
kable(posterior_summaries, digits = 2,
caption = "Posterior Means for Range (phi) and Relative Nugget")
#| label: Bayesian kriging
#| cache: true
# Load required package
library(geoR)
# Create a list to store the results for each year
bayes_results <- list()
# Prepare grid points and altitude covariate for prediction
pred_grid <- grid[, c("x", "y")]
pred_covar <- data.frame(alt = grid$alt)
# Define discrete grids for the priors of spatial parameters
prior_settings <- prior.control(
phi.discrete = seq(5, 300, length.out = 25),  # 25 points, borne sup à 300 km
phi.prior = "uniform",
tausq.rel.discrete = seq(0, 1, length.out = 5),
tausq.rel.prior = "uniform",
sigmasq.prior = "reciprocal"
)
# Loop over each year to fit the model and predict
for (yr in years) {
# 1. Extract data and convert to a geodata object
current_data <- yrs[[yr]]$data
geo_obj <- as.geodata(current_data,
coords.col = which(names(current_data) %in% c("x", "y")),
data.col = which(names(current_data) == "totanno"),
covar.col = which(names(current_data) == "alt"))
# 2. Dynamic model and trend selection based on HW4 results[cite: 3]
if (yr == "1973") {
# 1973: Spherical covariance and linear + altitude trend[cite: 3]
cov_mod <- "spherical"
trend_d <- ~ geo_obj$coords[, 1] + geo_obj$coords[, 2] + geo_obj$covar$alt
trend_l <- ~ pred_grid[, 1] + pred_grid[, 2] + pred_covar$alt
} else if (yr == "1974") {
# 1974: Spherical covariance and altitude trend[cite: 3]
cov_mod <- "spherical"
trend_d <- ~ alt
trend_l <- ~ pred_covar$alt
} else {
# 1980: Exponential covariance and altitude trend[cite: 3]
cov_mod <- "exponential"
trend_d <- ~ alt
trend_l <- ~ pred_covar$alt
}
# Perform Bayesian kriging with dynamic parameters
kb_model <- krige.bayes(geo_obj,
locations = pred_grid,
model = model.control(trend.d = trend_d,
trend.l = trend_l,
cov.model = cov_mod),
prior = prior_settings,
output = output.control(n.predictive = 1000,
quantile = c(0.025, 0.5, 0.975)))
# 3. Store the results
bayes_results[[yr]] <- kb_model
}
