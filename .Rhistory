#| label: setup
library(bmstdr)
library(spBayes)
library(rstan)
library(coda)
library(ggplot2)
# Load wolfcamp data directly without loading geoR.dll
lazyLoad(file.path(find.package("geoR"), "data", "Rdata"))
coords <- as.matrix(wolfcamp$coords)
z      <- as.numeric(wolfcamp$data)
n      <- length(z)
# Centre coordinates for better MCMC mixing of the linear trend
x0 <- mean(coords[, 1]); y0 <- mean(coords[, 2])
df <- data.frame(
x   = coords[, 1],
y   = coords[, 2],
x_c = coords[, 1] - x0,
y_c = coords[, 2] - y0,
z   = z
)
D_mat <- as.matrix(dist(coords))
X_mat <- model.matrix(~ x_c + y_c, data = df)
set.seed(2026)
#| label: functions
#| code-fold: true
# ML fit (reference, exponential covariance)
fit_ml_exp <- function(z, X, D) {
n <- length(z)
maxd <- max(D)
gls_ml <- function(range_val, nu) {
R  <- chol(exp(-D / range_val) + diag(nu, n))
Xs <- backsolve(R, X, transpose = TRUE)
zs <- backsolve(R, z, transpose = TRUE)
beta <- solve(crossprod(Xs), crossprod(Xs, zs))
s2   <- sum((zs - Xs %*% beta)^2) / n
list(logLik = -0.5 * (n * log(2 * pi) + 2 * sum(log(diag(R))) + n * log(s2) + n),
beta = c(beta), sigma2 = s2)
}
nll <- function(p) {
v <- tryCatch(-gls_ml(exp(p[1]), exp(p[2]))$logLik, error = function(e) 1e10)
if (is.finite(v)) v else 1e10
}
o <- optim(log(c(0.3 * maxd, 0.2)), nll, method = "L-BFGS-B",
lower = log(c(1, 1e-4)), upper = log(c(3 * maxd, 100)))
r_hat <- exp(o$par[1]); nu_hat <- exp(o$par[2])
g <- gls_ml(r_hat, nu_hat)
list(beta = g$beta, sigma2 = g$sigma2, tau2 = nu_hat * g$sigma2, range = r_hat)
}
# Proper scores from posterior predictive draws (n_te x N matrix)
score_draws <- function(y, draws) {
if (nrow(draws) != length(y)) draws <- t(draws)
pred  <- apply(draws, 1, median)
lower <- apply(draws, 1, quantile, probs = 0.025)
upper <- apply(draws, 1, quantile, probs = 0.975)
width <- upper - lower
is95  <- width + 40 * pmax(lower - y, 0) + 40 * pmax(y - upper, 0)
# Empirical CRPS: E|X - y| - 0.5 E|X - X'|
crps_vec <- sapply(seq_along(y), function(i) {
x <- sort(draws[i, ])
m <- length(x)
e1 <- mean(abs(x - y[i]))
e2 <- sum((2 * seq_len(m) - m - 1) * x) / (m^2)
e1 - e2
})
# Normal approximation to predictive density for LogS
mu_d <- rowMeans(draws)
sd_d <- apply(draws, 1, sd)
logs_vec <- -dnorm(y, mean = mu_d, sd = sd_d, log = TRUE)
data.frame(
y = y, pred = pred, lower = lower, upper = upper,
CRPS = crps_vec, LogS = logs_vec, IS95 = is95,
covered = (y >= lower & y <= upper), width = width
)
}
# Helper to format bmstdr$params rows cleanly
fmt_bm_row <- function(mat, idx) {
if (is.character(idx) && !(idx %in% rownames(mat))) return("—")
sprintf("%.2f [%.2f, %.2f]", mat[idx, 1], mat[idx, 3], mat[idx, 4])
}
#| label: fit-three-options
# 1. Option "none" (exact conjugate model, fixed phi, no nugget)
t0 <- proc.time()
fit_none <- Bspatial(
package      = "none",
model        = "spat",
formula      = z ~ x_c + y_c,
data         = df,
coordtype    = "plain",
coords       = 1:2,
phi          = 1 / ml_fit$range,
prior.sigma2 = c(2, 20000),
N            = 2000,
mchoice      = FALSE,
plotit       = FALSE,
verbose      = FALSE
)
t_none <- (proc.time() - t0)[["elapsed"]]
# 2. Option "spBayes" (adaptive Metropolis MCMC via spLM)
t0 <- proc.time()
fit_spb <- Bspatial(
package      = "spBayes",
formula      = z ~ x_c + y_c,
data         = df,
coordtype    = "plain",
coords       = 1:2,
prior.phi    = c(1 / 300, 1 / 5),
prior.sigma2 = c(2, 20000),
prior.tau2   = c(2, 5000),
N            = 10000,
burn.in      = 5000,
mchoice      = FALSE,
plotit       = FALSE,
verbose      = FALSE
)
t_spb <- (proc.time() - t0)[["elapsed"]]
# 3. Option "stan" (HMC / NUTS via rstan)
t0 <- proc.time()
fit_stan <- Bspatial(
package      = "stan",
formula      = z ~ x_c + y_c,
data         = df,
coordtype    = "plain",
coords       = 1:2,
prior.phi    = c(1 / 300, 1 / 5),
prior.sigma2 = c(2, 20000),
prior.tau2   = c(2, 5000),
N            = 2000,
burn.in      = 1000,
no.chains    = 2,
mchoice      = FALSE,
plotit       = FALSE,
verbose      = FALSE
)
#| label: setup
library(bmstdr)
library(spBayes)
library(rstan)
options(mc.cores = parallel::detectCores())
rstan_options(auto_write = TRUE)
library(coda)
library(ggplot2)
# Load wolfcamp data directly without loading geoR.dll
lazyLoad(file.path(find.package("geoR"), "data", "Rdata"))
coords <- as.matrix(wolfcamp$coords)
z      <- as.numeric(wolfcamp$data)
n      <- length(z)
# Centre coordinates for better MCMC mixing of the linear trend
x0 <- mean(coords[, 1]); y0 <- mean(coords[, 2])
df <- data.frame(
x   = coords[, 1],
y   = coords[, 2],
x_c = coords[, 1] - x0,
y_c = coords[, 2] - y0,
z   = z
)
D_mat <- as.matrix(dist(coords))
X_mat <- model.matrix(~ x_c + y_c, data = df)
set.seed(2026)
fit_stan_test <- Bspatial(
package      = "stan",
formula      = z ~ x_c + y_c,
data         = df,
coordtype    = "plain",
coords       = 1:2,
prior.phi    = c(1 / 300, 1 / 5),
prior.sigma2 = c(2, 20000),
prior.tau2   = c(2, 5000),
N            = 500,
burn.in      = 250,
no.chains    = 1,
mchoice      = FALSE,
plotit       = FALSE,
verbose      = TRUE
)
z_mean <- mean(df$z)
z_sd   <- sd(df$z)
df_std <- data.frame(
x_s   = df$x_c / 100,
y_s   = df$y_c / 100,
z_std = (df$z - z_mean) / z_sd
)
t0 <- proc.time()
fit_stan_test <- Bspatial(
package      = "stan",
formula      = z_std ~ x_s + y_s,
data         = df_std,
coordtype    = "plain",
coords       = 1:2,
prior.phi    = c(1 / 3, 1 / 0.05),   # équivalent à range dans [5, 300] miles
prior.sigma2 = c(2, 0.2),
prior.tau2   = c(2, 0.05),
N            = 1000,
burn.in      = 500,
no.chains    = 2,
mchoice      = FALSE,
plotit       = FALSE,
verbose      = TRUE
)
z_mean <- mean(df$z)
z_sd   <- sd(df$z)
df_std <- data.frame(
x_s   = df$x_c / 100,
y_s   = df$y_c / 100,
z_std = (df$z - z_mean) / z_sd
)
t0 <- proc.time()
fit_stan_test <- Bspatial(
package      = "stan",
formula      = z_std ~ x_s + y_s,
data         = df_std,
coordtype    = "plain",
coords       = 1:2,
prior.phi    = c(1 / 3, 1 / 0.05),   # équivalent à range dans [5, 300] miles
prior.sigma2 = c(2, 0.2),
prior.tau2   = c(2, 0.05),
N            = 1000,
burn.in      = 500,
no.chains    = 2,
mchoice      = FALSE,
plotit       = FALSE,
verbose      = TRUE
)
(proc.time() - t0)[["elapsed"]]
