# Define the parameter sequences
sigma2_seq <- seq(180000, 220000, by = 5000)  # 9 values
phi_seq    <- seq(40000, 75000, by = 5000)    # 8 values
nugget_seq <- seq(0, 100000, by = 5000)       # 21 values
kappa_seq  <- c(0.1, 0.5, 1.0, 1.5, 2.0)      # 5 values for kappa
# Grid for standard models: 9 * 8 * 21 = 1512 combinations
param_grid_base <- expand.grid(sigma2 = sigma2_seq,
phi = phi_seq,
