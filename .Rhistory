type = "latex",
title = "Risultati delle Regressioni",
dep.var.labels = "MPG",
covariate.labels = c("Peso", "Cavalli", "Tempo (1/4 miglio)", "Rapporto finale"),
column.labels = c("Modello 1", "Modello 2", "Modello 3", "Modello 4"),
align = TRUE,
no.space = TRUE,
out = "tabella_regressioni.tex")
