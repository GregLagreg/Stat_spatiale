#| label: setup
library(ggplot2)
load("../data/RainData.RData")      # gives `dati` (stations, all years) and `grid` (prediction points)
# Coordinates in km, centred on the stations (better numerical behaviour); altitude in km.
# The same centring is used for the stations and for the grid.
x0 <- mean(dati$XUTM); y0 <- mean(dati$YUTM)
prep <- function(d) transform(d, x = (XUTM - x0) / 1000, y = (YUTM - y0) / 1000, alt = Quota / 1000)
dati <- prep(dati[!is.na(dati$totanno), ])
grid <- prep(grid)
stopifnot(!anyNA(dati[, c("x", "y", "alt")]), !anyNA(grid[, c("x", "y", "alt")]))
# One list per year: data, response, coordinates and matrix of distances between stations
yrs <- lapply(split(dati, dati$anno), function(d)
list(data = d, z = d$totanno, co = as.matrix(d[, c("x", "y")]),
D = as.matrix(dist(d[, c("x", "y")]))))
years <- names(yrs)
years <- c("1973", "1974", "1980")
yrs <- yrs[years]
#| label: posterior-diagnostics
#| fig-width: 10
#| fig-height: 4
library(knitr)
# Data frame to store posterior summaries
posterior_summaries <- data.frame()
# Set up plotting area for one row and three columns (one plot per year)
par(mfrow = c(1, 3))
for (yr in years) {
post <- bayes_results[[yr]]$posterior
# Extract discrete marginal probabilities for phi and tau
phi_vals <- post$phi$values
phi_probs <- post$phi$prob
tau_vals <- post$tausq.rel$values
tau_probs <- post$tausq.rel$prob
# Calculate the posterior expected value (mean)
phi_mean <- sum(phi_vals * phi_probs)
tau_mean <- sum(tau_vals * tau_probs)
# Store the results in the summary table
posterior_summaries <- rbind(posterior_summaries, data.frame(
Year = yr,
Phi_Mean_km = phi_mean,
Tau_Rel_Mean = tau_mean
))
# Plot the posterior distribution for the range parameter (phi)
plot(phi_vals, phi_probs, type = "h", lwd = 3, col = "steelblue",
main = paste("Posterior of Phi -", yr),
xlab = "Range (phi) in km", ylab = "Probability")
points(phi_vals, phi_probs, pch = 16, col = "darkblue")
}
