sim_gamma <- matrix(NA, nrow = nrow(vr_res), ncol = nsim)
for (i in 1:nsim) {
data_1974$res_perm <- sample(data_1974$res_lm)
vr_perm <- variogram(res_perm ~ 1, locations = ~ XUTM + YUTM, data = data_1974, boundaries = vr_res$dist)
sim_gamma[, i] <- vr_perm$gamma
}
env_low <- apply(sim_gamma, 1, min, na.rm = TRUE)
env_high <- apply(sim_gamma, 1, max, na.rm = TRUE)
plot(vr_res$dist, vr_res$gamma,
ylim = range(c(vr_res$gamma, env_low, env_high), na.rm = TRUE),
pch = 19, col = "blue",
xlab = "Distance", ylab = "Semivariance",
main = "Residual Semivariogram with Monte Carlo Envelope")
lines(vr_res$dist, vr_res$gamma, col = "blue")
lines(vr_res$dist, env_low, lty = 2, col = "red")
lines(vr_res$dist, env_high, lty = 2, col = "red")
