install.packages("leaflet")
library(leaflet)
cartographier_observations <- function(donnees, var_lon, var_lat) {
# Initialisation de la carte avec les données
leaflet(data = donnees) |>
# addTiles() ajoute le fond de carte par défaut (OpenStreetMap)
addTiles() |>
# addCircleMarkers ajoute un point pour chaque observation
addCircleMarkers(
lng = donnees[[var_lon]],   # Extraction de la colonne Longitude
lat = donnees[[var_lat]],   # Extraction de la colonne Latitude
radius = 5,                 # Taille des points
color = "#FF5733",          # Couleur (ici orange)
stroke = FALSE,             # Sans bordure
fillOpacity = 0.7,          # Opacité
# Option bonus : un petit popup au clic
popup = paste("Lon:", donnees[[var_lon]], "<br>Lat:", donnees[[var_lat]])
)
}
View(data_1974)
#| label: ma-carte
#| echo: false
# Utilisation de la fonction avec le jeu de données 'quakes'
cartographier_observations(
donnees = data_1974,
var_lon = "Lon10",
var_lat = "Lat10"
)
library(sf)
library(gstat)
library(ggplot2)
library(gstat)
library(ggplot2)
creer_variogramme <- function(donnees, var_x, var_y, var_output, code_epsg) {
# 1. Transformation en objet spatial (en mètres grâce à l'UTM)
donnees_sf <- st_as_sf(donnees, coords = c(var_x, var_y), crs = code_epsg)
# 2. Création de la formule dynamique (ex: "Mon_Output ~ 1")
# Le "~ 1" signifie que l'on étudie la variable brute, sans tendance externe
formule <- as.formula(paste(var_output, "~ 1"))
# 3. Calcul du variogramme expérimental
# gstat calcule automatiquement les distances et regroupe les points par classes
vario_exp <- variogram(formule, data = donnees_sf)
# 4. Création du graphique avec ggplot2
ggplot(vario_exp, aes(x = dist, y = gamma)) +
geom_point(color = "#2c3e50", size = 3) +
geom_line(color = "#3498db", linetype = "dashed", alpha = 0.6) +
labs(
title = "Variogramm",
subtitle = paste("Evolution of the spatial variance for :", var_output),
x = "Distance",
y = "Semi-variance (Gamma)"
) +
theme_minimal() +
theme(
plot.title = element_text(face = "bold"),
panel.grid.minor = element_blank()
)
}
#| label: variogramme-pollution
#| echo: false
#| fig-cap: "Analyse of the spatial variance"
# Exemple d'appel de la fonction (en supposant que votre zone UTM est 32631)
creer_variogramme(
donnees = mon_dataset,
var_x = "XUTM",
var_y = "YUTM",
var_output = "totanno", # Remplacez par le nom de votre variable à étudier
code_epsg = 32633
)
